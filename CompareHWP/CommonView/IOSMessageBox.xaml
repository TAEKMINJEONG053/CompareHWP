<Window x:Class="CompareHWP.CommonView.IOSMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CompareHWP.CommonView"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Background="#66000000">
        <Border Width="600"
                Background="White"
                CornerRadius="16"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <!-- 복사 버튼 -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding IconText}"
                               FontSize="22"
                               Foreground="{Binding IconColor}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#111111"
                               VerticalAlignment="Center" />

                    <!-- Copy Button -->
                    <Button Width="32"
                            Height="32"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding CopyCommand}"
                            ToolTip="복사"
                            Background="#F2F2F7"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="16">
                                    <TextBlock Text="⧉"
                                               FontSize="16"
                                               Foreground="#007AFF"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Message -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="200"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               FontSize="14" />
                </ScrollViewer>

                <!-- Countdown -->
                <TextBlock Grid.Row="2"
                           Text="{Binding CountdownText}"
                           Foreground="Gray"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />

                <!-- Buttons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding CancelVisibility}"
                            Height="42"
                            Margin="0,0,6,0"
                            Background="#EFEFF4"
                            BorderThickness="0"
                            Width="150"
                            Cursor="Hand" />

                    <Button Content="OK"
                            Command="{Binding OkCommand}"
                            Visibility="{Binding OkVisibility}"
                            Height="42"
                            Margin="6,0,0,0"
                            Background="#007AFF"
                            Foreground="White"
                            BorderThickness="0"
                            Width="150"
                            Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
